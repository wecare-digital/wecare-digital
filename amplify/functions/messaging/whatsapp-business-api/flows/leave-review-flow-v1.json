{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": { "REVIEW_FORM": ["CONFIRM"], "CONFIRM": [] },
  "screens": [
    {
      "id": "REVIEW_FORM",
      "title": "Leave a Review",
      "data": {
        "order_ref": {
          "type": "string",
          "__example__": "Order WD-ORD-A7K2M9PQ"
        },
        "ratings": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [ { "id": "5", "title": "\u2b50\u2b50\u2b50\u2b50\u2b50 Excellent" }, { "id": "4", "title": "\u2b50\u2b50\u2b50\u2b50 Good" }, { "id": "3", "title": "\u2b50\u2b50\u2b50 Average" }, { "id": "2", "title": "\u2b50\u2b50 Below Average" }, { "id": "1", "title": "\u2b50 Poor" } ]
        },
        "categories": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [ { "id": "service", "title": "Service" }, { "id": "product", "title": "Product" }, { "id": "delivery", "title": "Delivery" }, { "id": "support", "title": "Support" }, { "id": "other", "title": "Other" } ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Leave a Review" },
          { "type": "TextBody", "text": "Share your experience with our service. Your feedback helps us improve." },
          { "type": "TextCaption", "text": "${data.order_ref}" },
          { "type": "Dropdown", "name": "rating", "label": "Rating", "required": true, "data-source": "${data.ratings}" },
          { "type": "Dropdown", "name": "category", "label": "Category", "required": true, "data-source": "${data.categories}" },
          { "type": "TextArea", "name": "review_text", "label": "Your Feedback", "required": true, "max-length": 500, "helper-text": "Tell us what went well or what could be better." },
          { "type": "Footer", "label": "Submit Review", "on-click-action": { "name": "data_exchange", "payload": { "rating": "${form.rating}", "category": "${form.category}", "review_text": "${form.review_text}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Review Submitted",
      "terminal": true,
      "data": {
        "review_id": { "type": "string", "__example__": "WD-REV-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Thank you for your feedback! Your review has been submitted." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Thank You!" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Review Reference" },
          { "type": "TextSubheading", "text": "${data.review_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}