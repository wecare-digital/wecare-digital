{
  "version": "7.3",
  "routing_model": {
    "SELECT_ORDER": [
      "REQUEST"
    ],
    "REQUEST": [
      "CONFIRMATION"
    ],
    "CONFIRMATION": []
  },
  "screens": [
    {
      "id": "SELECT_ORDER",
      "title": "Submit Request",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Select order"
          },
          {
            "type": "TextBody",
            "text": "Choose the order you need help with."
          },
          {
            "type": "Form",
            "name": "request_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "parent_order",
                "label": "Order",
                "required": true,
                "data-source": [
                  {
                    "id": "WD-ORD-K4M7PQR9",
                    "title": "Order · K4M7PQR9"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "navigate",
                  "payload": {
                    "parent_order": "${form.parent_order}"
                  },
                  "next": {
                    "type": "screen",
                    "name": "REQUEST"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REQUEST",
      "title": "Submit Request",
      "data": {
        "parent_order": {
          "type": "string",
          "__example__": "WD-ORD-K4M7PQR9"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "How can we help?"
          },
          {
            "type": "Form",
            "name": "request_form",
            "children": [
              {
                "type": "TextArea",
                "name": "request",
                "label": "What do you need help with?",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "payload": {
                    "parent_order": "${data.parent_order}",
                    "request": "${form.request}"
                  },
                  "next": {
                    "type": "screen",
                    "name": "CONFIRMATION"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMATION",
      "title": "Confirm",
      "terminal": true,
      "data": {
        "parent_order": {
          "type": "string",
          "__example__": "WD-ORD-K4M7PQR9"
        },
        "request": {
          "type": "string",
          "__example__": "Please help with this order."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Submit this request?"
          },
          {
            "type": "TextCaption",
            "text": "Order"
          },
          {
            "type": "TextBody",
            "text": "${data.parent_order}"
          },
          {
            "type": "TextCaption",
            "text": "Request"
          },
          {
            "type": "TextBody",
            "text": "${data.request}"
          },
          {
            "type": "Footer",
            "label": "Submit request",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "design_service": "submit-request",
                "parent_order": "${data.parent_order}",
                "request": "${data.request}"
              }
            }
          }
        ]
      }
    }
  ]
}
