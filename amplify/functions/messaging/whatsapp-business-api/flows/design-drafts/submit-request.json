{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "ORDER_SELECT": [
      "SUBMIT_REQUEST_FORM"
    ],
    "SUBMIT_REQUEST_FORM": [
      "THANK_YOU"
    ],
    "THANK_YOU": []
  },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Submit Request",
      "data": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "WD-ORD-K4M7PQR9",
              "title": "Order · K4M7PQR9"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Select order"
          },
          {
            "type": "Dropdown",
            "name": "order_id",
            "label": "Order",
            "required": true,
            "data-source": "${data.orders}"
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "order_id": "${form.order_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUBMIT_REQUEST_FORM",
      "title": "Submit Request",
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "WD-ORD-K4M7PQR9"
        },
        "order_short_id": {
          "type": "string",
          "__example__": "K4M7PQR9"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "Order"
          },
          {
            "type": "TextBody",
            "text": "${data.order_short_id}"
          },
          {
            "type": "TextArea",
            "name": "description",
            "label": "What do you need help with?",
            "required": true,
            "max-length": 600
          },
          {
            "type": "Footer",
            "label": "Submit request",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "order_id": "${data.order_id}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "THANK_YOU",
      "title": "Request Submitted",
      "terminal": true,
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "WD-ORD-K4M7PQR9"
        },
        "order_short_id": {
          "type": "string",
          "__example__": "K4M7PQR9"
        },
        "request_number": {
          "type": "string",
          "__example__": "WD-SR-A1B2C3D4"
        },
        "payment_ref_id": {
          "type": "string",
          "__example__": "N/A"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Request submitted"
          },
          {
            "type": "TextCaption",
            "text": "Request number"
          },
          {
            "type": "TextBody",
            "text": "${data.request_number}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "request_number": "${data.request_number}"
              }
            }
          }
        ]
      }
    }
  ]
}
