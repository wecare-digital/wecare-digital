{
  "name": "wecare-digital-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Amplify Gen 2 backend definition. A SEPARATE INSTALL ROOT from the web app on purpose - see docs/npm-ci-backend-isolation.md. The four packages here bundle an inconsistent OpenTelemetry set that makes `npm ci` impossible in whichever lockfile contains them, and nothing outside this folder imports any of them.",
  "type": "module",
  "scripts": {
    "sandbox": "ampx sandbox",
    "deploy": "ampx pipeline-deploy",
    "postinstall": "node ../scripts/guard_braces_depth.cjs && node ../scripts/guard_minimatch_preprocess.cjs",
    "predeploy": "node ../scripts/guard_braces_depth.cjs --check && node ../scripts/guard_minimatch_preprocess.cjs --check && node ../scripts/check_minimatch_preprocess.cjs",
    "presandbox": "node ../scripts/guard_braces_depth.cjs --check && node ../scripts/guard_minimatch_preprocess.cjs --check && node ../scripts/check_minimatch_preprocess.cjs"
  },
  "dependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-amplify/backend-cli": "^1.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "fast-xml-parser": "5.11.1",
    "immutable@3": "3.8.4",
    "mysql2": "3.24.4",
    "csv-parse": "7.0.2",
    "handlebars": "4.7.10",
    "@graphql-tools/utils": "12.0.3",
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=9": "11.0.4"
  }
}
