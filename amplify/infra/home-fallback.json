{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Unused subdomains redirect to WECARE home; www preserves paths when canonicalising to apex.",
  "Resources": {
    "RedirectFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": "wecare-home-fallback",
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Only www host canonicalises with full path/query; unused subdomains redirect home",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var host = (request.headers.host && request.headers.host.value || '').toLowerCase();\n  var destination = 'https://wecare.digital/';\n  var status = 302;\n  if (host === 'wecare.digital') {\n    destination = 'https://wecare.digital' + (request.uri || '/');\n    var qs = request.querystring || {};\n    var parts = [];\n    Object.keys(qs).forEach(function (name) {\n      var entry = qs[name];\n      var vals = entry && entry.multiValue && entry.multiValue.length ? entry.multiValue : [entry];\n      vals.forEach(function (val) {\n        if (!val) return;\n        parts.push(encodeURIComponent(name) + (val.value === '' ? '' : '=' + encodeURIComponent(val.value)));\n      });\n    });\n    if (parts.length) destination += '?' + parts.join('&');\n    status = 301;\n  }\n  return {\n    statusCode: status,\n    statusDescription: status === 301 ? 'Moved Permanently' : 'Found',\n    headers: {\n      location: {value: destination},\n      'cache-control': {value: 'no-store'},\n      'x-content-type-options': {value: 'nosniff'},\n      'referrer-policy': {value: 'no-referrer'},\n      'content-security-policy': {value: \"default-src 'none'; frame-ancestors 'none'\"}\n    }\n  };\n}\n"
      }
    },
    "LogBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AccessControl": "LogDeliveryWrite",
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerPreferred"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Status": "Enabled",
              "ExpirationInDays": 30
            }
          ]
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Redirect unused WECARE subdomains to home",
          "Aliases": [
            "*.wecare.digital"
          ],
          "IPV6Enabled": true,
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "home",
              "DomainName": "wecare.digital",
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "home",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "RedirectFunction",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": "arn:aws:acm:us-east-1:775261844268:certificate/f75d0db0-d476-443a-b787-96c4931862d2",
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Logging": {
            "Bucket": {
              "Fn::GetAtt": [
                "LogBucket",
                "DomainName"
              ]
            },
            "IncludeCookies": false,
            "Prefix": "cloudfront/"
          }
        }
      }
    }
  },
  "Outputs": {
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "CertificateArn": {
      "Value": "arn:aws:acm:us-east-1:775261844268:certificate/f75d0db0-d476-443a-b787-96c4931862d2"
    }
  }
}
