{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Arogya Yatra owned drafts and explicitly authorized read-only Apollo catalogue; no always-on compute.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": "Customer Cognito-authenticated drafts and opt-in provider catalogue reads. Provider permissions are absent unless explicitly enabled with exact registry, KMS, verified grant owner and credential ARNs. No booking submission, payment capture, scheduler or new secret/key/table."
  },
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "ApolloRegistryTableName": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^wecare-workspace-mcp$"
    },
    "ApolloTokenKeyArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:kms:us-east-1:775261844268:key/[a-f0-9-]{36}$"
    },
    "ApolloAutomationEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Enable only after provider-approved service automation and explicit administrator delegation."
    },
    "ApolloGmailGrantOwner": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-f0-9]{64}$",
      "NoEcho": true,
      "Description": "Exact verified staff OAuth owner hash, selected by an authorized administrator."
    },
    "ApolloGoogleOAuthSecretArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:secretsmanager:us-east-1:775261844268:secret:wecare/seo/google-oauth-[A-Za-z0-9]+$",
      "Description": "Existing approved workspace Google OAuth client secret ARN."
    }
  },
  "Resources": {
    "Bookings": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wecare-arogya-bookings",
        "BillingMode": "PROVISIONED",
        "TableClass": "STANDARD",
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 5,
          "WriteCapacityUnits": 5
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "customerId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "draftId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "customerId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "draftId",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "arogya-yatra"
          },
          {
            "Key": "cost-policy",
            "Value": "fixed-free-tier-capacity"
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/wecare-arogya-booking",
        "RetentionInDays": 7
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OwnedAppointmentDrafts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bookings",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wecare-arogya-booking:*"
                  }
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:GetItem",
                        "dynamodb:UpdateItem"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ApolloRegistryTableName}"
                      },
                      "Condition": {
                        "ForAllValues:StringEquals": {
                          "dynamodb:LeadingKeys": [
                            "arogya:provider:apollo",
                            {
                              "Fn::Sub": "connection:${ApolloGmailGrantOwner}:google-gmail-apollo"
                            }
                          ]
                        },
                        "Null": {
                          "dynamodb:LeadingKeys": "false"
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "kms:Encrypt",
                        "kms:Decrypt"
                      ],
                      "Resource": {
                        "Ref": "ApolloTokenKeyArn"
                      },
                      "Condition": {
                        "StringEquals": {
                          "kms:EncryptionContext:purpose": "arogya-provider",
                          "kms:EncryptionContext:record": "arogya:provider:apollo"
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "kms:Encrypt",
                        "kms:Decrypt"
                      ],
                      "Resource": {
                        "Ref": "ApolloTokenKeyArn"
                      },
                      "Condition": {
                        "StringEquals": {
                          "kms:EncryptionContext:purpose": "workspace-mcp",
                          "kms:EncryptionContext:provider": "google-gmail-apollo",
                          "kms:EncryptionContext:owner": {
                            "Ref": "ApolloGmailGrantOwner"
                          }
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "secretsmanager:GetSecretValue"
                      ],
                      "Resource": [
                        {
                          "Ref": "ApolloGoogleOAuthSecretArn"
                        }
                      ]
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:GetItem"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ApolloRegistryTableName}"
                      },
                      "Condition": {
                        "ForAllValues:StringEquals": {
                          "dynamodb:LeadingKeys": [
                            "arogya:provider:credentials"
                          ]
                        },
                        "Null": {
                          "dynamodb:LeadingKeys": "false"
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "ApolloReadEnabled",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "kms:Decrypt"
                      ],
                      "Resource": {
                        "Ref": "ApolloTokenKeyArn"
                      },
                      "Condition": {
                        "StringEquals": {
                          "kms:EncryptionContext:purpose": "arogya-provider",
                          "kms:EncryptionContext:record": "arogya:provider:credentials"
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "Logs",
      "Properties": {
        "FunctionName": "wecare-arogya-booking",
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "handler.handler",
        "MemorySize": 128,
        "Timeout": {
          "Fn::If": [
            "ApolloReadEnabled",
            60,
            15
          ]
        },
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "AROGYA_BOOKINGS_TABLE": {
              "Ref": "Bookings"
            },
            "CUSTOMER_POOL_ID": "us-east-1_46ULYuukt",
            "APOLLO_REGISTRY_TABLE": {
              "Fn::If": [
                "ApolloReadEnabled",
                {
                  "Ref": "ApolloRegistryTableName"
                },
                ""
              ]
            },
            "APOLLO_TOKEN_KEY_ARN": {
              "Fn::If": [
                "ApolloReadEnabled",
                {
                  "Ref": "ApolloTokenKeyArn"
                },
                ""
              ]
            },
            "APOLLO_AUTOMATION_ENABLED": {
              "Fn::If": [
                "ApolloReadEnabled",
                {
                  "Ref": "ApolloAutomationEnabled"
                },
                "false"
              ]
            },
            "APOLLO_GMAIL_GRANT_OWNER": {
              "Fn::If": [
                "ApolloReadEnabled",
                {
                  "Ref": "ApolloGmailGrantOwner"
                },
                ""
              ]
            },
            "APOLLO_GOOGLE_OAUTH_SECRET_ARN": {
              "Fn::If": [
                "ApolloReadEnabled",
                {
                  "Ref": "ApolloGoogleOAuthSecretArn"
                },
                ""
              ]
            }
          }
        },
        "TracingConfig": {
          "Mode": "PassThrough"
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "arogya-yatra"
          }
        ]
      }
    },
    "Url": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Function"
        },
        "AuthType": "NONE",
        "Cors": {
          "AllowOrigins": [
            "https://wecare.digital"
          ],
          "AllowMethods": [
            "POST"
          ],
          "AllowHeaders": [
            "Authorization",
            "Content-Type"
          ],
          "MaxAge": 300
        }
      }
    },
    "UrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "FunctionUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Url",
          "FunctionUrl"
        ]
      }
    },
    "TableName": {
      "Value": {
        "Ref": "Bookings"
      }
    }
  },
  "Conditions": {
    "ApolloReadEnabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApolloAutomationEnabled"
            },
            "true"
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ApolloRegistryTableName"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ApolloTokenKeyArn"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ApolloGmailGrantOwner"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ApolloGoogleOAuthSecretArn"
                },
                ""
              ]
            }
          ]
        }
      ]
    }
  },
  "Rules": {
    "ApolloActivationRequiresBinding": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "ApolloAutomationEnabled"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::And": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ApolloRegistryTableName"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ApolloTokenKeyArn"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ApolloGmailGrantOwner"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ApolloGoogleOAuthSecretArn"
                      },
                      ""
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "All four provider and authorization inputs are mandatory when automation is enabled."
        }
      ]
    }
  }
}
