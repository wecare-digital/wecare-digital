{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // scripts/check-versions.ts runs under Node 24's native type stripping, which does no
    // extension resolution — the import must literally say `.ts` or Node cannot find it.
    // tsc rejects that spelling unless this is on. Safe here because `noEmit` is set, so
    // nothing is written that could carry an unresolvable specifier into a build output.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    // Next.js 16 generates TWO page/layout validators that each declare a top-level
    // `PagesPageConfig`: `.next/types/validator.ts` for `next build` and
    // `.next/dev/types/validator.ts` for `next dev`. Including BOTH globs made tsc see two
    // declarations of that identifier whenever a dev run and a build had both left artifacts
    // behind — a hard `TS2300: Duplicate identifier` that failed `next build`'s own type check.
    // Only the build validator belongs in the production type pass; `next dev`'s IDE integration
    // resolves its own dev types and does not need this glob. See the stale-artifact fix in
    // commit 57e4ba28, which added the dev glob and introduced the clash.
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "amplify/**/*",
    ".amplify/**/*",
    "store/**/*"
  ]
}
