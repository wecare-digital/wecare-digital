<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Stack CRM</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Deep Link: wecare:// scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>digital.wecare.stackcrm</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wecare</string>
			</array>
		</dict>
	</array>

	<!-- Universal Links: wecare.digital.
	     The apex, not the retired retired-legacy-host.invalid: Apple fetches
	     /.well-known/apple-app-site-association directly and does NOT follow a
	     redirect, so an associated domain that 301s can never verify. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:wecare.digital</string>
		<string>webcredentials:wecare.digital</string>
	</array>

	<!-- Push Notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Usage descriptions: truthful, and free of an app name, because this one project builds
	     both the internal Workspace app and the public WECARE.DIGITAL shell. iOS shows each only
	     when the matching feature is used. Kept because WKWebView needs them: a photo/file input
	     offers "Take Photo or Video" (camera, microphone) and the photo picker, the Workspace
	     softphone asks for the microphone, and an image's "Add to Photos" writes to the library.
	     Removed 2026-10-25 with nothing in the app that uses them: NSContactsUsageDescription
	     (no contacts sync exists) and NSFaceIDUsageDescription (no LocalAuthentication use). -->
	<key>NSCameraUsageDescription</key>
	<string>The camera is used only when you choose to take a photo or video to attach or send.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used only when you start a call, or record a video to attach or send.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Your photo library is used only when you choose a photo or video to attach or send.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Photos are saved to your library only when you choose to save an image.</string>

	<!-- Status Bar -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
</dict>
</plist>
