# Sinch RCS — the only five variables this project needs from Sinch.
#
# Consumed by the `sinch-rcs` MCP server in .kiro/settings/mcp.json, which is
# referenced as ${SINCH_...} so no value is ever written into that file.
#
# These are for TOOLING ONLY. The running application does not read them: it loads
# its Sinch credentials from AWS Secrets Manager (`wecare/sinch/rcs`) at request
# time. Adding them here does not change any runtime behaviour.

# From the project selector in the Sinch Build dashboard.
# Our application's configured project id is a UUID and is already stored in
# `wecare/sinch/rcs` under `project_id`.
SINCH_PROJECT_ID=

# From Settings -> Access keys in the Sinch Build dashboard.
#
# NEITHER OF THESE EXISTS YET. Verified 2026-09-22: `wecare/sinch/rcs` contains
# exactly five fields - app_id, bot_id, password, project_id, username - and no
# key_id or key_secret. The MCP server refuses to start on a partial triple
# ("set all three, or none and a mode"), so it ships disabled until these exist.
#
# The access key secret is shown ONCE at creation. If it is lost, a new access key
# must be created.
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# The Conversation API app that carries the RCS channel. Our application's value is
# a ULID stored in `wecare/sinch/rcs` under `app_id`.
SINCH_CONVERSATION_APP_ID=

# Conversation API region. Must match the region of the RCS Sender bound to the app,
# or the channel cannot work.
SINCH_CONVERSATION_REGION=

# ── Deliberately absent ───────────────────────────────────────────────────────
#
# This is an RCS-only Sinch integration, so the following are NOT set, and the MCP
# server is started with `--tags rcs,conversation` so their tool groups never load:
#
#   DEFAULT_SMS_ORIGINATOR        SMS
#   APPLICATION_KEY               Voice / Verification
#   APPLICATION_SECRET            Voice / Verification
#   CALLING_LINE_IDENTIFICATION   Voice
#   MAILGUN_API_KEY               Email
#   MAILGUN_DOMAIN                Email
#   MAILGUN_SENDER_ADDRESS        Email
#   GEOCODING_API_KEY             location feature, unused here
#
# The `conversation` tag still exposes three tools that would breach the RCS-only
# rule - set-whatsapp-channel-on-app, send-whatsapp-template-message and
# set-sms-channel-on-app - so they are listed in `disabledTools` rather than being
# left to discipline.


# ---------------------------------------------------------------------------
# The map on /contact/ — OPTIONAL key, and it changes which map you get
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_BROWSER_KEY=
#
# Leave it unset and /contact/ renders the keyless embed described below: a working
# map, but Google's pan / zoom / fullscreen / Street View controls are visible and
# can only be neutered by an overlay, never hidden. They are painted inside a
# cross-origin iframe, so nothing in this repo can reach them.
#
# Set it and the page switches to the Maps JavaScript API, which is the only way to
# get satellite imagery and disableDefaultUI — controls genuinely gone, drag and
# scroll-zoom off natively rather than faked with an overlay.
#
# THIS ONE IS MEANT TO BE PUBLIC, unlike every other key in this file. It ships in
# the page source because that is Google's model for Maps browser keys: you protect
# it with restrictions, not secrecy. Set BOTH in the Cloud console, because neither
# can be enforced from here:
#   Application restrictions -> HTTP referrers, *.wecare.digital/*
#   API restrictions         -> Maps JavaScript / Static Maps / Places only
# With Application restrictions set to None, anyone who views source can bill the
# project without limit. Note this is NOT the Google Translate key, which is a real
# secret and lives in Secrets Manager behind a Lambda (wecare/google/cloud).
#
# Put the value in .env.local, never here — .gitignore:17 covers .env* so .env.local
# cannot be committed, and this file can.
#
# --- the keyless fallback, for reference ---
#
# src/components/ContactLocation.tsx now uses Google's keyless embed endpoint
# (maps?q=...&output=embed), so the map renders inline for everyone with no
# credential, no billing account, no referrer allowlist and no rotation. That
# also removes a real problem: output:'export' inlines NEXT_PUBLIC_* into the
# built HTML, so the old key was going to be publicly readable in the page
# source and would have needed its own embed-only, referrer-locked key to stay
# un-abusable.
#
# Do NOT reintroduce a key for this. If you need the richer Google APIs the
# owner's standalone map app uses (Weather, Air Quality, Solar), those are
# server-side and belong in a Lambda with a non-public key, never in NEXT_PUBLIC_*.
