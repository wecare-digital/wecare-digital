{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNativeCustomerAndServiceIntent",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:775261844268:table/stack-wecare-digital-ContactsTable",
        "arn:aws:dynamodb:us-east-1:775261844268:table/stack-wecare-digital-ServiceRequestsTable"
      ]
    },
    {
      "Sid": "VerifyNativeCustomer",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:ListUsers"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:775261844268:userpool/us-east-1_46ULYuukt"
    },
    {
      "Sid": "SendCanonicalNativePayment",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:775261844268:function:wecare-outbound-whatsapp:live"
    }
  ]
}
