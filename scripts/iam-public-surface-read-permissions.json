{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAmplifyCustomRules",
      "Effect": "Allow",
      "Action": "amplify:GetApp",
      "Resource": "arn:aws:amplify:us-east-1:775261844268:apps/d22dm4b0jn71jw"
    },
    {
      "Sid": "ReadMcpFunctionAndItsBundle",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:775261844268:function:wecare-mcp",
        "arn:aws:lambda:us-east-1:775261844268:function:wecare-mcp:*"
      ]
    },
    {
      "Sid": "ReadHttpApiTopology",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:us-east-1::/apis/zllr9lrg7j*"
    },
    {
      "Sid": "ReadSharedLambdaRolePolicyForScopeSimulation",
      "Effect": "Allow",
      "Action": "iam:GetRolePolicy",
      "Resource": "arn:aws:iam::775261844268:role/wecare-digital-lambda-role"
    },
    {
      "Sid": "SimulateProposedSharedLambdaPolicy",
      "Effect": "Allow",
      "Action": "iam:SimulateCustomPolicy",
      "Resource": "*"
    }
  ]
}
