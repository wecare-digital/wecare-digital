{
  "name": "wecare-digital-admin-platform",
  "version": "1.0.0",
  "description": "WECARE.DIGITAL Admin Platform - Multi-channel messaging system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-public-pages.js && node scripts/generate-vendor-css.js && next build && node scripts/generate-sitemap.js && node scripts/generate-blog-search-index.js && node scripts/generate-blog-rss.js && node scripts/generate-llms-txt.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "amplify": "amplify/node_modules/.bin/ampx sandbox",
    "amplify:deploy": "amplify/node_modules/.bin/ampx pipeline-deploy",
    "cap:init": "npx cap init \"Stack CRM\" digital.wecare.stackcrm --web-dir out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:build": "next build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:public:sync": "npx cap sync --config capacitor.public.config.ts",
    "cap:public:open:ios": "npx cap open ios --config capacitor.public.config.ts",
    "cap:public:open:android": "npx cap open android --config capacitor.public.config.ts",
    "amplify:install": "npm install --prefix amplify --no-audit --no-fund",
    "demo-video": "node scripts/make_demo_video.mjs",
    "postinstall": "node scripts/guard_braces_depth.cjs",
    "prebuild": "node scripts/guard_braces_depth.cjs --check && node scripts/check-retired-public-pages.cjs",
    "preamplify": "node scripts/guard_braces_depth.cjs --check",
    "preamplify:deploy": "node scripts/guard_braces_depth.cjs --check",
    "precap:build": "node scripts/guard_braces_depth.cjs --check"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "aws-amplify": "^6.22.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "lodash": "4.18.1",
    "fast-xml-parser": "5.11.1",
    "immutable@3": "3.8.4",
    "mysql2": "3.24.4",
    "csv-parse": "7.0.2",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
