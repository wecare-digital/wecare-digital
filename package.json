{
  "name": "wecare-digital-admin-platform",
  "version": "1.0.0",
  "description": "WECARE.DIGITAL Admin Platform - Multi-channel messaging system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-public-pages.js && node scripts/generate-vendor-css.js && next build && node scripts/generate-sitemap.js && node scripts/generate-blog-search-index.js && node scripts/generate-llms-txt.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "amplify": "amplify/node_modules/.bin/ampx sandbox",
    "amplify:deploy": "amplify/node_modules/.bin/ampx pipeline-deploy",
    "cap:init": "npx cap init \"Stack CRM\" digital.wecare.stackcrm --web-dir out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:build": "next build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "amplify:install": "npm install --prefix amplify --no-audit --no-fund",
    "demo-video": "node scripts/make_demo_video.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1076.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/google-maps": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "aws-amplify": "^6.18.0",
    "material": "file:vendor/material",
    "next": "^16.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "lodash": "4.18.1",
    "fast-xml-parser": "5.11.1",
    "immutable@3": "3.8.4",
    "mysql2": "3.24.4",
    "csv-parse": "7.0.2"
  }
}
