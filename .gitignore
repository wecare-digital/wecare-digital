# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
.pytest_cache/

# Production
build/
dist/
.next/
out/

# Environment variables
.env*
# ...but example templates carry no values and are meant to be committed. Without
# this negation `.env.example` needs `git add -f` every time, which is how a real
# `.env` eventually gets force-added by muscle memory.
!.env*.example

# AWS Amplify
amplify/mock-data/
amplify/backend/amplify-meta.json
amplify/backend/awscloudformation/
amplify/#current-cloud-backend/
amplify/.config/
.amplify/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Generated by the CI workflows into the repo root: route-auth.yml greps a subset
# of requirements-dev.txt into these before installing. Reproducing a gate run
# locally therefore creates them, and they must never be committed — the pinned
# source of truth is requirements-dev.txt.
/ci-test-requirements.txt
/ci-aws-requirements.txt

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/
temp/
deploy_tmp/
scripts/_pkg*/

# Build artifacts
*.zip
tsconfig.tsbuildinfo

# Secrets (never commit)
*.pem
*.key
secrets.json

# Audit outputs (may contain credentials from Meta API)
wa_sip_audit/
**/wa_sip_audit/

# AWS Credentials (never commit)
.aws/
aws-credentials.json
credentials.json

# Utility scripts (local only)
_*.py
_*.json
_*.ps1
_*.txt
recordings/
_*.txt
_*.cmd
tmp-*.py

# ...but `_*.py` also matches `__init__.py`, which silently kept
# amplify/functions/shared/lambda_utils/__init__.py out of the repo even though
# every deployed Lambda package contains it. Keep package markers tracked.
!**/__init__.py
flow-*.txt
flow-*.png
sr-*.txt
*-deploy.zip

# SEO AI audit data (local storage for pilot)
.seo-data/

# Amplify generated outputs (regenerated on deploy)
amplify_outputs.json
tsc_*.txt

# auto-generated by Next.js on every dev/build; flip-flops between dev/build variants — don't track
next-env.d.ts

# Local MCP config — contains secrets (Wix API key). Do not commit.
.kiro/settings/mcp.json
# ...and its timestamped backups. The live file is ignored because an MCP server block can
# carry an `env` with provider credentials; a backup of it carries the same risk, so the
# rotation copies (mcp.json.backup-*, mcp.json.before-*.bak) must never be committed either.
.kiro/settings/mcp.json.*

# Agent scratch output. Kept inside the workspace on purpose: the per-workspace
# Kiro permissions file grants fs_read/fs_write for the root, while anything in
# /tmp falls through to the user-level file and prompts for approval once per new
# filename. Never tracked.
.scratch/

# Git worktrees created for parallel work. A worktree at origin/stack is how a
# session pushes without touching a shared dirty tree, so these are created and
# removed constantly. Untracked and unignored, each one showed up in `git status`
# as a pending change, which is misleading precisely when the point of the
# worktree was to keep the shared tree legible.
.worktrees/

# Partial output of `aws_account_inventory.py --only ...`. The full inventory at
# docs/execution/aws-inventory.{json,md} is committed; a single-collector run is
# a local debugging artifact where every other family reads null.
docs/execution/aws-inventory.partial.*
# Blog ingestion working files. NOT a size decision — these hold verbatim extracted
# text from third-party PDFs and pages, so committing them puts someone else's book
# into our git history permanently. `content/conversations/ledger.json` keeps the
# source SHA-256, so provenance survives without retaining the text. The finished Anew
# articles in content/conversations/batches/ ARE committed; they are ours.
content/conversations/extracts/
content/conversations/drafts/
# Lambda code snapshots taken before a deploy, for rollback. Binary, and the config JSON
# beside each one records the CodeSha256 that identifies it, so the zip itself does not
# need to be in history.
docs/execution/snapshots/*.zip

# Agent task artifacts: per-run findings, plans, reviews and verification notes written
# under .agents/tasks by workflow/agent runs. They are transient scratch, never built or
# deployed, and should not clutter source control or the repo history.
.agents/
# Reproducible workspace research output; source, decisions and snapshots are tracked.
docs/execution/workspace-page-inventory-20261007.json
docs/execution/workspace-pages-20261007.csv
docs/workspace-review/workspace-review-data.json
docs/workspace-review/workspace-audit-report.html
# Vendored third-party stylesheet, written by scripts/generate-vendor-css.js at the start of
# every build. `@aws-amplify/ui-react`'s component CSS is served from here by a <link> on the
# authenticated routes instead of being bundled into the global CSS every public page loads.
# Deliberately NOT committed: a checked-in vendor copy drifts from the installed version
# silently, and this one is regenerated before `next build` runs.
public/vendor/amplify-ui.css
# Generated rescan source graphs are preserved in task outputs.
/docs/execution/workspace-page-inventory-20261008.json
/docs/execution/workspace-pages-20261008.csv

# R2 full generated audit graph retained locally under outputs instead of Git.
/docs/execution/workspace-page-inventory-20261008-r2.json
/docs/execution/workspace-rescan-aws-20261008-r2.json
